{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "configdirector scan and validate --json output",
  "description": "The code references `configdirector scan --json` found in a repository, and the findings `configdirector validate --json` adds.",
  "type": "object",
  "required": ["project", "filesScanned", "references", "dynamicReferences"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "description": "The slug of the project the scan ran for.",
      "type": "string"
    },
    "filesScanned": {
      "description": "How many source files were read. 0 means nothing in the scanned location could be scanned.",
      "type": "integer",
      "minimum": 0
    },
    "references": {
      "description": "Places where the code reads a config key: SDK calls, and the project's keys quoted elsewhere in the code.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/directReference"
          },
          {
            "$ref": "#/$defs/indirectReference"
          }
        ]
      }
    },
    "dynamicReferences": {
      "description": "SDK calls whose key is neither a string literal nor a constant the scan could resolve, so the key they read is not known.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/dynamicReference"
      }
    },
    "findings": {
      "description": "Only in `configdirector validate --json` output: the problems the check found in direct references, empty when it found none.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/unknownKeyFinding"
          },
          {
            "$ref": "#/$defs/deprecatedKeyFinding"
          },
          {
            "$ref": "#/$defs/typeMismatchFinding"
          },
          {
            "$ref": "#/$defs/availabilityMismatchFinding"
          },
          {
            "$ref": "#/$defs/enumValueNotAllowedFinding"
          }
        ]
      }
    }
  },
  "$defs": {
    "file": {
      "description": "The file's path from the directory the scan ran in.",
      "type": "string"
    },
    "line": {
      "description": "The line of the key in the file, starting at 1.",
      "type": "integer",
      "minimum": 1
    },
    "sdk": {
      "description": "The ConfigDirector SDK or OpenFeature provider family the call belongs to.",
      "enum": [
        "js-client",
        "js-server",
        "react",
        "react-native",
        "vue",
        "nuxt-client",
        "nuxt-server",
        "nextjs-client",
        "nextjs-server",
        "openfeature-web",
        "openfeature-node",
        "flutter",
        "openfeature-flutter",
        "swift",
        "openfeature-swift",
        "android",
        "openfeature-android",
        "python",
        "openfeature-python",
        "java",
        "openfeature-java",
        "dotnet",
        "openfeature-dotnet",
        "go",
        "openfeature-go"
      ]
    },
    "call": {
      "description": "The SDK method, function or annotation that names the key.",
      "type": "string"
    },
    "test": {
      "description": "Whether the call sets a value on an SDK test client rather than reading a config.",
      "type": "boolean"
    },
    "getterType": {
      "description": "The type the method reads the config as, when its name fixes it, such as getBoolean. number means integer or float.",
      "enum": ["boolean", "string", "integer", "float", "number", "json"]
    },
    "directReference": {
      "type": "object",
      "required": ["key", "file", "line", "kind", "sdk", "call", "test"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "The config key: the string literal in the call, or the string the constant passed to the call holds.",
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "kind": {
          "description": "The key is a string literal in an SDK call, or a constant the scan resolved.",
          "const": "direct"
        },
        "sdk": {
          "$ref": "#/$defs/sdk"
        },
        "call": {
          "$ref": "#/$defs/call"
        },
        "argument": {
          "description": "The key argument as written in the code, present when the scan resolved it from a constant or property rather than reading a string literal.",
          "type": "string"
        },
        "default": {
          "$ref": "#/$defs/inCodeDefaultValue"
        },
        "getterType": {
          "$ref": "#/$defs/getterType"
        },
        "test": {
          "$ref": "#/$defs/test"
        },
        "snippet": {
          "$ref": "#/$defs/snippet"
        }
      }
    },
    "indirectReference": {
      "type": "object",
      "required": ["key", "file", "line", "kind", "test"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "The project's current or deprecated key, as quoted in the code.",
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "kind": {
          "description": "The key is quoted outside an SDK call, such as in a wrapper function, a key list or a test fixture.",
          "const": "indirect"
        },
        "test": {
          "description": "Whether the file is in a test directory or has a test name.",
          "type": "boolean"
        },
        "snippet": {
          "$ref": "#/$defs/snippet"
        }
      }
    },
    "snippet": {
      "description": "The reference line and the lines around it, as many before and after it as --context-lines asks for and the file holds. Absent with --no-snippets, and in `configdirector validate --json` output.",
      "type": "object",
      "required": ["firstLine", "lines", "language", "truncatedLines"],
      "additionalProperties": false,
      "properties": {
        "firstLine": {
          "description": "The number of the snippet's first line in the file, starting at 1.",
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "description": "The lines, in order, without their line endings. A line longer than 250 characters is cut to its first 250.",
          "type": "array",
          "minItems": 1,
          "maxItems": 11,
          "items": {
            "type": "string",
            "maxLength": 250
          }
        },
        "language": {
          "description": "The language to highlight the lines as, from the file's extension.",
          "enum": [
            "typescript",
            "tsx",
            "javascript",
            "jsx",
            "vue",
            "svelte",
            "dart",
            "swift",
            "kotlin",
            "java",
            "python",
            "csharp",
            "go"
          ]
        },
        "truncatedLines": {
          "description": "The numbers of the lines that were cut to 250 characters, empty when none was.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "inCodeDefaultValue": {
      "description": "The in-code default value the call passes, when it is a literal. A json value is the literal as written in the code.",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "float"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": ["string", "json"]
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "dynamicReference": {
      "type": "object",
      "required": ["file", "line", "sdk", "call", "argument"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/file"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "sdk": {
          "$ref": "#/$defs/sdk"
        },
        "call": {
          "$ref": "#/$defs/call"
        },
        "argument": {
          "description": "The key argument as written in the code.",
          "type": "string"
        }
      }
    },
    "findingKey": {
      "description": "The config key the direct reference reads.",
      "type": "string"
    },
    "sdkType": {
      "description": "Whether an SDK runs in clients, such as browsers and mobile apps, or on servers.",
      "enum": ["client", "server"]
    },
    "unknownKeyFinding": {
      "type": "object",
      "required": ["kind", "key", "file", "line"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "No config in the project has this key as its current or a deprecated key. Archived configs are not listed, so their keys are unknown too.",
          "const": "unknown-key"
        },
        "key": {
          "$ref": "#/$defs/findingKey"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "line": {
          "$ref": "#/$defs/line"
        }
      }
    },
    "deprecatedKeyFinding": {
      "type": "object",
      "required": ["kind", "key", "file", "line", "currentKey"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "The key is a deprecated key of a renamed config.",
          "const": "deprecated-key"
        },
        "key": {
          "$ref": "#/$defs/findingKey"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "currentKey": {
          "description": "The renamed config's current key.",
          "type": "string"
        }
      }
    },
    "typeMismatchFinding": {
      "type": "object",
      "required": ["kind", "key", "file", "line", "configType", "servedAs"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "The in-code default value or the typed getter reads the config as a type the SDKs do not serve it as.",
          "const": "type-mismatch"
        },
        "key": {
          "$ref": "#/$defs/findingKey"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "configType": {
          "description": "The config's type, such as boolean, enum or timespan.",
          "type": "string"
        },
        "servedAs": {
          "description": "The type the SDKs are served the config as, which the check compared against: a timespan is served as a float and a URL as a string, and an enum's values as strings or numbers.",
          "enum": ["boolean", "string", "integer", "float", "json", "string-enum", "number-enum"]
        },
        "default": {
          "$ref": "#/$defs/inCodeDefaultValue"
        },
        "getterType": {
          "$ref": "#/$defs/getterType"
        }
      }
    },
    "availabilityMismatchFinding": {
      "type": "object",
      "required": ["kind", "key", "file", "line", "sdk", "sdkType", "configAvailableTo"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "A client SDK reads a server-only config, or a server SDK reads a client-only config.",
          "const": "availability-mismatch"
        },
        "key": {
          "$ref": "#/$defs/findingKey"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "sdk": {
          "$ref": "#/$defs/sdk"
        },
        "sdkType": {
          "$ref": "#/$defs/sdkType"
        },
        "configAvailableTo": {
          "description": "The kinds of SDK the config is served to.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/sdkType"
          }
        }
      }
    },
    "enumValueNotAllowedFinding": {
      "type": "object",
      "required": ["kind", "key", "file", "line", "default", "allowedValues"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "The in-code default value is not one of the enum config's allowed values.",
          "const": "enum-value-not-allowed"
        },
        "key": {
          "$ref": "#/$defs/findingKey"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "default": {
          "$ref": "#/$defs/inCodeDefaultValue"
        },
        "allowedValues": {
          "description": "The enum config's allowed values, as ConfigDirector stores them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
